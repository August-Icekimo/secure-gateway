# 複製為 .env 後填入真實值。.env 已被 gitignore，絕不可 commit。
# 詳見 CLAUDE.md「Required Environment Variables」。

# Route53 DNS（憑證 DNS-01 驗證）
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_HOSTED_ZONE_ID=YOUR_HOSTED_ZONE_ID

# Google OAuth SSO
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET

# caddy-security JWT 簽章金鑰（openssl rand -hex 32）
JWT_SHARED_KEY=GENERATE_WITH_openssl_rand_hex_32

# Guacamole 資料庫
POSTGRES_PASSWORD=YOUR_DB_PASSWORD

# 後端服務 LAN IP
SSH_SERVER_IP=192.168.x.x
COCKPIT_SERVER_IP=192.168.x.x

# 根網域
DOMAIN_NAME=your-domain.example

# CrowdSec bouncer 金鑰（首次啟動後：docker exec crowdsec cscli bouncers add caddy-bouncer）
CROWDSEC_BOUNCER_KEY=GENERATED_BY_CSCLI

# 取得 authp/admin 角色的 Google 帳號
ALLOWEDE_GMAIL=you@gmail.com
