{
	# 全域設定：定義模組執行順序
	order coraza_waf first
	order crowdsec before reverse_proxy
	order rate_limit before reverse_proxy

	# Security 插件順序
	order authenticate before respond
	order authorize before basicauth

	# 設定全域選項，例如 ACME Email (選填)
	# email your-email@example.com

	# --- Security 全域配置 ---
	security {
		# 建立 local identity store
		local identity store localdb {
			realm local
			path /etc/caddy/portal/users.json
		}

		# Google OAuth 設定
		oauth identity provider google {
			realm google
			driver google
			client_id {$GOOGLE_CLIENT_ID}
			client_secret {$GOOGLE_CLIENT_SECRET}
			# domain_name auth.{$DOMAIN_NAME}     # 建議設定，避免 Cookie 跨域問題
		}

		authentication portal my_portal {
			crypto default token lifetime 3600
			crypto key sign-verify {$JWT_SHARED_KEY}

			enable identity provider google
			enable identity store localdb

			# Cookie 設定在頂層 domain，讓所有 subdomain 共享登入狀態
			cookie domain {$DOMAIN_NAME}

			ui {
				theme basic
				logo url "/assets/icons/brand/logo.svg"
				logo description "Icekimo Secure Gateway"
				custom css path /etc/caddy/portal/custom.css
				custom js path /etc/caddy/portal/custom.js

				# 可替換的頁面背景圖（見 portal/assets/README.md）
				static_asset "assets/background.svg" "image/svg+xml" "/etc/caddy/portal/assets/background.svg"

				# SVG 圖示（CSS mask 填色，見 portal/assets/icons/README.md）
				static_asset "assets/icons/brand/logo.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/brand/logo.svg"
				static_asset "assets/icons/brand/google.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/brand/google.svg"
				static_asset "assets/icons/ui/user.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/user.svg"
				static_asset "assets/icons/ui/key.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/key.svg"
				static_asset "assets/icons/ui/unlock.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/unlock.svg"
				static_asset "assets/icons/ui/check.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/check.svg"
				static_asset "assets/icons/ui/check-circle.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/check-circle.svg"
				static_asset "assets/icons/ui/caret-left.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/caret-left.svg"
				static_asset "assets/icons/ui/book.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/book.svg"
				static_asset "assets/icons/ui/info-circle.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/info-circle.svg"
				static_asset "assets/icons/ui/exclamation-triangle.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/exclamation-triangle.svg"
				static_asset "assets/icons/ui/times.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/times.svg"
				static_asset "assets/icons/ui/times-circle.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/times-circle.svg"
				static_asset "assets/icons/ui/qrcode.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/qrcode.svg"
				static_asset "assets/icons/ui/sign-out.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/sign-out.svg"
				static_asset "assets/icons/ui/home.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/home.svg"
				static_asset "assets/icons/ui/layer-group.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/layer-group.svg"
				static_asset "assets/icons/ui/microchip.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/microchip.svg"
				static_asset "assets/icons/ui/mobile.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/mobile.svg"
				static_asset "assets/icons/ui/redo.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/redo.svg"
				static_asset "assets/icons/ui/desktop.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/desktop.svg"
				static_asset "assets/icons/ui/server.svg" "image/svg+xml" "/etc/caddy/portal/assets/icons/ui/server.svg"

				links {
					"Guacamole" "https://gconsole.{$DOMAIN_NAME}/guacamole/" icon "las la-desktop"
					"Cockpit" "https://cockpit.{$DOMAIN_NAME}" icon "las la-server"
				}
			}

			# 確保環境變數定義的超級管理員自動擁有最高權限
			transform user {
				match email {$ALLOWEDE_GMAIL}
				action add role authp/admin
				action add role authp/user
			}

			# Agent terminal 唯讀檢視群組（不連帶開放 Guacamole）
			# 每個帳號一個 transform（match email 為單值），email 存在 .env
			transform user {
				match email {$SANDBOXVIEW_GMAIL_1}
				action add role sandboxview
			}
			transform user {
				match email {$SANDBOXVIEW_GMAIL_2}
				action add role sandboxview
			}
			transform user {
				match email {$SANDBOXVIEW_GMAIL_3}
				action add role sandboxview
			}
		}

		# 授權策略：一般使用者 (Guacamole 等)
		authorization policy user_policy {
			set auth url https://auth.{$DOMAIN_NAME}/oauth2/google
			crypto key verify {$JWT_SHARED_KEY}
			allow roles authp/user
		}

		# 授權策略：管理員 (Cockpit 等)
		authorization policy admin_policy {
			set auth url https://auth.{$DOMAIN_NAME}/
			crypto key verify {$JWT_SHARED_KEY}
			allow roles authp/admin
		}

		# 授權策略：Agent terminal 唯讀檢視（sandboxview 群組 + 管理員）
		authorization policy agent_policy {
			set auth url https://auth.{$DOMAIN_NAME}/oauth2/google
			crypto key verify {$JWT_SHARED_KEY}
			allow roles sandboxview authp/admin
		}
	}

	# --- Layer 4 流量分流 (Port 443) ---
	# layer4 {
	#     :443 {
	#         @ssh {
	#             match ssh
	#         }
	#         route @ssh {
	#             proxy {$SSH_SERVER_IP}:22 
	#         }
	# 
	#         route {
	#             proxy 127.0.0.1:8443
	#         }
	#     }
	# }

	# 啟用 CrowdSec 全域應用配置
	crowdsec {
		api_key {$CROWDSEC_BOUNCER_KEY}
		api_url http://crowdsec:8080
	}
}

# --- Layer 7 應用層處理 (Internal Port 8443) ---

# --- Webhook Subdomain (Isolated) ---
cindy.{$DOMAIN_NAME} {
	log {
		output file /var/log/caddy/webhook.log
	}
	tls {
		dns route53
		resolvers 8.8.8.8
	}

	# 僅保留 CrowdSec 阻擋，移除 WAF 與 Auth
	crowdsec

	handle /webhook/line-hermes* {
		rewrite * /line/webhook
		reverse_proxy {$COCKPIT_SERVER_IP}:8646
	}
	handle /webhook/line* {
		reverse_proxy {$COCKPIT_SERVER_IP}:8086
	}
	handle /webhook/telegram* {
		reverse_proxy {$COCKPIT_SERVER_IP}:8086
	}

	# Agent terminal view — Google OAuth 後放行（sandboxview / admin）
	# 註：唯讀僅由 :8000 服務本身決定，gateway 只負責存取控制
	handle {
		authorize with agent_policy
		reverse_proxy {$COCKPIT_SERVER_IP}:8000 {
			flush_interval -1
		}
	}
}

*.{$DOMAIN_NAME}, {$DOMAIN_NAME} {
	tls {
		dns route53
		resolvers 8.8.8.8
	}
	# 限制連線速率
	rate_limit {
		zone dynamic {
			key {remote_host}
			events 100
			window 1m
		}
	}

	# 啟用 CrowdSec 阻擋
	crowdsec

	# 啟用 WAF (需確認 coraza.conf 存在)
	@not_ws {
		not header Connection *Upgrade*
	}
	coraza_waf @not_ws {
		directives `Include /etc/caddy/coraza.conf`
	}

	# 1. 驗證入口
	@auth host auth.{$DOMAIN_NAME}
	handle @auth {
		# /guacamole/ 重導向到正確 subdomain
		@guac_path path /guacamole/*
		handle @guac_path {
			redir https://gconsole.{$DOMAIN_NAME}{uri} permanent
		}
		authenticate with my_portal
	}

	# 2. Guacamole 遠端桌面
	@guac host gconsole.{$DOMAIN_NAME}
	handle @guac {
		authorize with user_policy
		reverse_proxy guacamole:8080 {
			flush_interval -1
		}
	}

	# 3. Cockpit (Web Management)
	@cockpit host cockpit.{$DOMAIN_NAME}
	handle @cockpit {
		authorize with admin_policy

		reverse_proxy http://{$COCKPIT_SERVER_IP}:9090 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			flush_interval -1
			header_down Content-Security-Policy "reg-replace {$COCKPIT_SERVER_IP}:9090 cockpit.{$DOMAIN_NAME}"
		}
	}

	# 4. Webhook Services (LINE / Telegram) — MOVED TO DEDICATED BLOCK

	# 5. 錯誤頁面處理 (Error Handling) — 與 portal 同樣的液態玻璃風格
	handle_errors {
		header Content-Type text/html
		respond <<HTML
            <!DOCTYPE html>
            <html lang="en">
            <head>
                <meta charset="utf-8">
                <meta name="viewport" content="width=device-width, initial-scale=1">
                <meta name="color-scheme" content="light dark">
                <title>{err.status_code} {err.status_text}</title>
                <style>
                    :root {
                        color-scheme: light dark;
                        --bg: #e9eef6; --glass: rgba(255,255,255,.55);
                        --border: rgba(255,255,255,.65); --text: #1c2433; --dim: #51607a;
                    }
                    @media (prefers-color-scheme: dark) {
                        :root {
                            --bg: #0c1018; --glass: rgba(28,34,48,.55);
                            --border: rgba(255,255,255,.14); --text: #eef2f8; --dim: #9aa7bd;
                        }
                    }
                    body {
                        margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
                        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                        color: var(--text);
                        background:
                            radial-gradient(60% 80% at 12% 8%, rgba(96,158,255,.4), transparent 62%),
                            radial-gradient(55% 70% at 88% 18%, rgba(186,188,255,.38), transparent 60%),
                            var(--bg);
                    }
                    .card {
                        text-align: center; padding: 3rem 3.5rem; max-width: 24rem;
                        background: var(--glass); border: 1px solid var(--border); border-radius: 28px;
                        -webkit-backdrop-filter: blur(28px) saturate(180%);
                        backdrop-filter: blur(28px) saturate(180%);
                        box-shadow: 0 24px 60px rgba(31,45,80,.18);
                    }
                    h1 { margin: 0 0 .5rem; font-size: 3rem; letter-spacing: -.02em; }
                    p { margin: 0; color: var(--dim); }
                    .brand { margin-top: 1.5rem; font-size: .8rem; color: var(--dim); opacity: .7; }
                </style>
            </head>
            <body>
                <div class="card">
                    <h1>{err.status_code}</h1>
                    <p>{err.status_text}</p>
                    <div class="brand">Icekimo Secure Gateway</div>
                </div>
            </body>
            </html>
        HTML {err.status_code}
	}
}
